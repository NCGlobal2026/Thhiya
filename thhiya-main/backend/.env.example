# Thhiya Backend v2 - Environment Variables Template
# Copy this file to .env and fill in your actual values

# Environment
NODE_ENV=production

# Server Configuration
PORT=3000

# Database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database?appName=production
# Optional tuneable timeouts (ms) for server selection and connect
# MONGODB_SERVER_SELECTION_MS=10000
# MONGODB_CONNECT_TIMEOUT_MS=10000
# Optional pool size
# MONGODB_MAX_POOLSIZE=10

# CORS Configuration (comma-separated origins)
CORS_ORIGIN=https://yourdomain.com,https://www.yourdomain.com

# Security (Required if implementing authentication)
# JWT_SECRET=your-super-secure-jwt-secret-here
# JWT_EXPIRES_IN=7d

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
# Log level: debug, info, warn, error, silent
# Default: debug in development, warn in production
LOG_LEVEL=info

# Log format: pretty (colored console output), json (structured for log aggregation)
# Default: pretty in development, json in production
LOG_FORMAT=pretty

# Rate Limiting (Optional)
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100

# =============================================================================
# EMAIL CONFIGURATION (Mailgun)
# =============================================================================
# Set EMAIL_ENABLED=true to activate email sending
# When disabled, emails will be logged but not sent (safe for development)
EMAIL_ENABLED=false

# Mailgun API credentials
# Get these from: https://app.mailgun.com/settings/api_security
MAILGUN_API_KEY=your-mailgun-api-key
MAILGUN_DOMAIN=sandbox123.mailgun.org
MAILGUN_BASE_URL=https://api.mailgun.net

# Email addresses
# ADMIN_EMAIL receives notifications when someone fills the BANT/MEDDIC/INTENT(BMI) form
ADMIN_EMAIL=admin@yourdomain.com
# FROM_EMAIL is the sender address for all outgoing emails
FROM_EMAIL=Thhiya <noreply@yourdomain.com>
FROM_NAME=Thhiya

# =============================================================================
# GEMINI / PROVIDER INTENT REFRESH
# =============================================================================
# Staging-first recommendation:
# - Set PROVIDER_INTENT_ALLOWED_ENVS=staging first
# - Keep PROVIDER_INTENT_MAX_UPDATES_PER_RUN low (e.g. 5-10) during rollout
# - Increase gradually after validating Gemini quota behavior
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-2.5-flash
# PROVIDER_INTENT_REFRESH_ENABLED=true
# PROVIDER_INTENT_STARTUP_ENABLED=true
# PROVIDER_INTENT_ALLOWED_ENVS=staging,development
# PROVIDER_INTENT_REFRESH_DAYS=14
# PROVIDER_INTENT_CHECK_CRON=0 2 * * *
# PROVIDER_INTENT_REFRESH_DELAY_MS=5000
# PROVIDER_INTENT_STARTUP_GRACE_MS=30000
# PROVIDER_INTENT_MAX_UPDATES_PER_RUN=25

GRAFANA_PROMETHEUS_URL=https://prometheus-prod-43-prod-ap-south-1.grafana.net/api/prom/push
GRAFANA_PROMETHEUS_USER=2846359
#GRAFANA_API_KEY=your_grafana_cloud_api_key_here
GRAFANA_API_KEY=your_grafana_cloud_api_key_here
