                    "id": "is-gp-cycle",
                    "type": "key_steps",
                    "title": "Payroll Process",
                    "content": {
                        "steps": [
                            {
                                "stepNumber": 1,
                                "title": "Tax Card",
                                "description": "Retrieve employee's electronic tax card usage (credits)."
                            },
                            {
                                "stepNumber": 2,
                                "title": "Deductions",
                                "description": "Calculate Pension (4%) and Union Dues (~1%)."
                            },
                            {
                                "stepNumber": 3,
                                "title": "Withholding",
                                "description": "Apply Tax Rate to (Gross - Pension) - Tax Credits."
                            },
                            {
                                "stepNumber": 4,
                                "title": "Reporting",
                                "description": "Submit PAYE return to RSK by the 14th of the following month."
                            }
                        ]
                    }
                },
                {
                    "id": "is-calc-flow",
                    "type": "key_steps",
                    "title": "Calculation",
                    "content": {
                        "steps": [
                            {
                                "stepNumber": 1,
                                "title": "Gross",
                                "description": "Monthly Salary."
                            },
                            {
                                "stepNumber": 2,
                                "title": "Pension",
                                "description": "Deduct 4% Pension."
                            },
                            {
                                "stepNumber": 3,
                                "title": "Tax Base",
                                "description": "Result is Taxable Income."
                            },
                            {
                                "stepNumber": 4,
                                "title": "Tax",
                                "description": "Apply 31.48% - 46.28% Brackets."
                            },
                            {
                                "stepNumber": 5,
                                "title": "Credits",
                                "description": "Subtract Personal Tax Credit (Persónuafsláttur)."
                            },
                            {
                                "stepNumber": 6,
                                "title": "Net",
                                "description": "Final Pay."
                            }
                        ]
                    }
