            "sections": [
                {
                    "id": "tl-eor-onboarding",
                    "type": "key_steps",
                    "title": "Onboarding Steps",
                    "content": {
                        "steps": [
                            {
                                "stepNumber": 1,
                                "title": "Contract Issuance",
                                "description": "Drafting the employment contract in Portuguese or Tetum (English courtesy translation standard). Must define fixed-term (CDD) vs indefinite (CDI) status."
                            },
                            {
                                "stepNumber": 2,
                                "title": "Social Security (CESS)",
                                "description": "Registration with the Contributory Regime of Social Security (CESS). Mandatory for all formal employees."
                            },
                            {
                                "stepNumber": 3,
                                "title": "TIN Registration",
                                "description": "Obtaining the Tax Identification Number (TIN) for the employee from the Timor-Leste Revenue Service."
                            },
                            {
                                "stepNumber": 4,
                                "title": "Bank Account",
                                "description": "Opening a USD account at BNU Timor, ANZ, or BNCTL for salary transfers."
                            }
                        ]
                    }
                },
                {
                    "id": "tl-eor-leave",
                    "type": "insights",
                    "title": "Leave Policy (Labor Code 2012)",
                    "content": {
                        "items": [
                            {
                                "type": "info",
                                "title": "Annual Leave",
                                "text": "Employees are entitled to 12 working days of paid annual leave after one year of service. Prorated at 1 day per month for partial years."
                            },
                            {
                                "type": "warning",
                                "title": "Sick Leave",
                                "text": "12 days of sick leave per year. The first 6 days are Paid 100%, the remaining 6 days are Paid 50%. Medical certificate required."
                            },
                            {
                                "type": "info",
                                "title": "Maternity Leave",
                                "text": "12 weeks of maternity leave (before and after birth). Compensation is 100% of salary, often reimbursed by CESS."
                            },
                            {
                                "type": "tip",
                                "title": "Compassionate Leave",
                                "text": "Up to 5 days for death of a close relative (spouse, parent, child). 2 days for other relatives."
                            }
                        ]
                    }
