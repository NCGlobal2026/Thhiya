                {
                    "id": "tl-eor-faq",
                    "type": "faq",
                    "title": "EOR FAQ",
                    "content": {
                        "faqs": [
                            {
                                "question": "Is the 13th Month mandatory?",
                                "answer": "No, the 13th month is not legally mandatory in Timor-Leste, but it is a common discretionary bonus."
                            },
                            {
                                "question": "What is the minimum wage?",
                                "answer": "The minimum wage is $115 USD per month."
                            },
                            {
                                "question": "Can we terminate easily?",
                                "answer": "Termination requires valid reason (Just Cause). Notice periods differ by tenure. Severance is typically 1 month per year of service."
                            },
                            {
                                "question": "What is the probation period?",
                                "answer": "Standard probation is 1 month, extendable to 3 months for skilled roles."
                            }
                        ]
                    }
