            "serviceName": "INCORPORATION & REGISTRATION(ENTITY SETUP)",
            "heroData": {
                "title": "Incorporation in Timor-Leste",
                "subtitle": "Easy Setup with SERVE",
                "description": "Register your Single-Shareholder Company (Unipessoal Lda) or Standard Lda via the SERVE One-Stop-Shop.",
                "bestFor": "Permanent Establishments",
                "icon": "incorporation-entity-setup"
            },
            "sections": [
                {
                    "id": "tl-inc-steps",
                    "type": "key_steps",
                    "title": "SERVE Registration Process",
                    "content": {
                        "steps": [
                            {
                                "stepNumber": 1,
                                "title": "Name Reservation",
                                "description": "Verify unique company name at SERVE (Service for Registration and Verification of Entrepreneurs)."
                            },
                            {
                                "stepNumber": 2,
                                "title": "Draft Statutes",
                                "description": "Draft Articles of Association. SERVE provides standard templates (Modelos) for 'Unipessoal Lda' and 'Lda'."
                            },
                            {
                                "stepNumber": 3,
                                "title": "Capital Deposit",
                                "description": "Deposit minimum capital (optional for some structures, but recommended $5,000 for credibility) at a local bank."
                            },
                            {
                                "stepNumber": 4,
                                "title": "Submission",
                                "description": "Submit Form SERVE_F_1 (Registration of Company) and supporting docs (Passport, Proof of Address) to SERVE office in Dili."
                            },
                            {
                                "stepNumber": 5,
                                "title": "Certification",
                                "description": "Receive the 'Certidão de Registo Comercial' (Commercial Registration Certificate) and TIN."
                            },
                            {
                                "stepNumber": 6,
                                "title": "Licensing",
                                "description": "Obtain specific sector license (e.g., from Petroleum Authority) if operating in regulated industries."
                            }
                        ]
                    }
                },
