                {
                    "id": "tl-gp-steps",
                    "type": "key_steps",
                    "title": "Payroll Cycle",
                    "content": {
                        "steps": [
                            {
                                "stepNumber": 1,
                                "title": "Gross Calculation",
                                "description": "Calculate base salary + overtime (1.5x) + allowances."
                            },
                            {
                                "stepNumber": 2,
                                "title": "Social Security",
                                "description": "Deduct 4% for employee share. Accrue 6% for employer share."
                            },
                            {
                                "stepNumber": 3,
                                "title": "WHT Check",
                                "description": "Apply 10% WHT on taxable amounts > $500 (residents) or full amount (non-residents)."
                            },
                            {
                                "stepNumber": 4,
                                "title": "Net Pay",
                                "description": "Distribute USD to local bank accounts."
                            },
                            {
                                "stepNumber": 5,
                                "title": "Filing",
                                "description": "File Monthly Tax Form by the 15th of the following month."
                            }
                        ]
                    }
                },
                {
                    "id": "tl-gp-overtime",
                    "type": "insights",
                    "title": "Overtime Rules",
                    "content": {
                        "items": [
                            {
                                "type": "info",
                                "title": "Standard OT",
                                "text": "Paid at 150% (Normal rate + 50%) for hours beyond 8h/day or 44h/week."
                            },
                            {
                                "type": "warning",
                                "title": "Weekend/Holiday OT",
                                "text": "Paid at 200% (Normal rate + 100%) for work on rest days or public holidays."
                            },
                            {
                                "type": "info",
                                "title": "Compensatory Rest",
                                "text": "Employees working on rest days are entitled to a compensatory rest day within the following 3 days."
                            }
                        ]
                    }
                },
