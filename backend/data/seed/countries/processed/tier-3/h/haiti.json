                    "type": "key_steps",
                    "title": "Onboarding Steps",
                    "content": {
                        "steps": [
                            {
                                "stepNumber": 1,
                                "title": "Contract Signature",
                                "description": "Employment contracts must be written in French or Creole. Fixed-term (CDD) allowed for specific tasks."
                            },
                            {
                                "stepNumber": 2,
                                "title": "ONA Registration",
                                "description": "Register employee with Office National d'Assurance-Vieillesse (ONA) for pension."
                            },
                            {
                                "stepNumber": 3,
                                "title": "OFATMA Registration",
                                "description": "Enroll in Office d'Assurance Accidents du Travail, Maladie et Maternité (OFATMA)."
                            },
                            {
                                "stepNumber": 4,
                                "title": "NIF Issuance",
                                "description": "Ensure employee has a valid Tax ID (NIF) from DGI."
