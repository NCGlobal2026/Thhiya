                    "id": "ht-gp-bonus",
                    "type": "insights",
                    "title": "Payroll Specifics",
                    "content": {
                        "items": [
                            {
                                "type": "info",
                                "title": "Bonuses",
                                "text": "The 13th Month (Bonis) is mandatory in Haiti. It must be paid between Dec 24 and Dec 31 and equals one month's salary."
                            },
                            {
                                "type": "warning",
                                "title": "Severance",
                                "text": "Notice periods vary by tenure (e.g. 1 month for <12 months service). Severance is typically negotiated but grounded in Labor Code."
                            }
                        ]
                    }
                },
                {
                    "id": "ht-calc-logic",
                    "type": "key_steps",
                    "title": "Calculation Flow",
                    "content": {
                        "steps": [
                            {
                                "stepNumber": 1,
                                "title": "Gross",
                                "description": "Monthly Salary."
                            },
                            {
                                "stepNumber": 2,
                                "title": "Deductions",
                                "description": "Subtract 6% ONA and 3% OFATMA."
                            },
                            {
                                "stepNumber": 3,
                                "title": "Tax Base",
                                "description": "Apply progressive tax rates to the balance."
                            },
                            {
                                "stepNumber": 4,
                                "title": "Net",
                                "description": "Gross - Deductions - Tax."
                            }
                        ]
                    }
                }
