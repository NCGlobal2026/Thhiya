            "heroData": {
                "title": "Incorporation Haiti",
                "subtitle": "MCI Registration",
                "description": "Form a Société Anonyme (SA) or SARL via the Ministry of Commerce and Industry.",
                "bestFor": "Long-term Investment",
                "icon": "incorporation-entity-setup"
            },
            "sections": [
                {
                    "id": "ht-inc-steps",
                    "type": "key_steps",
                    "title": "Registration Process",
                    "content": {
                        "steps": [
                            {
                                "stepNumber": 1,
                                "title": "Name Reservation",
                                "description": "Reserve company name at provisions of MCI (Ministry of Commerce and Industry)."
                            },
                            {
                                "stepNumber": 2,
                                "title": "Notarization",
                                "description": "Draft bylaws and have them notarized. A lawyer is mandatory for foreign investors."
                            },
                            {
                                "stepNumber": 3,
                                "title": "Capital Deposit",
                                "description": "Open a 'compte de blocage' at a local bank (Unibank, Sogebank) to deposit minimum capital."
                            },
                            {
                                "stepNumber": 4,
                                "title": "MCI Filing",
                                "description": "Submit dossier to MCI. Wait for authorization."
                            },
                            {
                                "stepNumber": 5,
                                "title": "Publication",
                                "description": "Publish notice in 'Le Moniteur' (Official Gazette)."
                            },
                            {
                                "stepNumber": 6,
                                "title": "NIF & Patente",
                                "description": "Register with DGI for Tax ID (NIF) and Business License (Patente)."
                            }
                        ]
                    }
                },
