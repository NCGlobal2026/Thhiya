                "icon": "incorporation-entity-setup"
            },
            "sections": [
                {
                    "id": "hn-inc-steps",
                    "type": "key_steps",
                    "title": "Setup Process",
                    "content": {
                        "steps": [
                            {
                                "stepNumber": 1,
                                "title": "Notary Deed",
                                "description": "Execute the Public Deed of Constitution before a Honduran Notary."
                            },
                            {
                                "stepNumber": 2,
                                "title": "Mercantil Registry",
                                "description": "Register the deed at the Registro Mercantil in the local Chamber of Commerce (Cámara de Comercio)."
                            },
                            {
                                "stepNumber": 3,
                                "title": "Tax ID (RTN)",
                                "description": "Obtain Registro Tributario Nacional (RTN) from SAR (Servicio de Administración de Rentas)."
                            },
                            {
                                "stepNumber": 4,
                                "title": "Operational Permit",
                                "description": "Apply for 'Permiso de Operación' from the Municipality."
                            },
                            {
                                "stepNumber": 5,
                                "title": "Labor Registration",
                                "description": "Register with Ministry of Labor, IHSS, RAP, and INFOP."
                            }
                        ]
                    }
