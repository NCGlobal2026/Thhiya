                    "content": {
                        "steps": [
                            {
                                "stepNumber": 1,
                                "title": "Gross Pay",
                                "description": "Base salary + Overtime."
                            },
                            {
                                "stepNumber": 2,
                                "title": "Deductions",
                                "description": "Withhold IHSS (Health/Pension) and RAP (Housing)."
                            },
                            {
                                "stepNumber": 3,
                                "title": "Income Tax",
                                "description": "Calculate ISR (Impuesto Sobre la Renta) on taxable base (Gross - Deductions - Medical Allowance L.40k)."
                            },
                            {
                                "stepNumber": 4,
                                "title": "Net Deposit",
                                "description": "Transfer to employee bank account (Banco Atlántida, BAC, Ficohsa)."
